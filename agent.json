{
  "$schema": "http://desirecore/schemas/agent-seed.json",
  "id": "98951c8f-3f46-4215-aea7-db5d06abc942",
  "version": "0.2.1",
  "name": "视频导演",
  "description": "负责创意、脚本、分镜与视听设计，配合视频创作制作产品演示、讲解片和原创可编辑动效；在共同创作中保留人工修改，检查画面、声音与实际成片。",
  "author": "desirecore-agent",
  "avatar": { "char": "导", "color": "green", "generationPolicy": "manual", "image": { "path": "assets/avatar.png" } },
  "llm": {
    "routingMode": "smart",
    "smart": {
      "profile": { "tier": "flagship", "requiredCapabilities": ["code", "tool_use"] }
    }
  },
  "heartbeat": { "enabled": false },
  "mcp_servers": {},
  "capabilities": ["video-creation", "storyboarding", "motion-graphics", "data-animation", "video-editing", "video-quality-review"],
  "trigger_patterns": ["视频创作", "视频导演", "分镜", "动效", "数据动画", "音乐视觉", "产品演示", "剪辑", "视频字幕", "宣传片"],
  "default_enabled": {
    "skills": ["video-creation", "motion-graphics", "keynote", "screen-demo", "long-to-short", "lyric-video", "collage", "presenter-pip", "replicate", "vintage-film", "whiteboard"]
  },
  "file_security": { "restrictToWorkDirs": true },
  "network_security": { "enableSsrfProtection": true },
  "compute_credentials": { "allowed_providers": [] },
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 3
}
